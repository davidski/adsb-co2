    {
      "id": 3,
      "type": "stat",
      "title": "Live CO₂ rate",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "adsb-co2"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "adsb-co2"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(co2_kg / dt_s), 0) * 3.6 AS co2_t_h\nFROM (SELECT DISTINCT ON (pass_id) pass_id, ts, co2_kg,\n             extract(epoch FROM ts - lag(ts) OVER (PARTITION BY pass_id ORDER BY ts)) AS dt_s\n      FROM track_points\n      WHERE pass_id IN (SELECT id FROM passes WHERE status = 'open') AND ts > now() - interval '6 minutes'\n      ORDER BY pass_id, ts DESC) t\nWHERE ts > now() - interval '30 seconds' AND dt_s > 0"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "suffix: t/hr"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "Latest stored 5 s increment of each open pass, scaled to kg/h (central estimate). Fuel flow = CO₂ ÷ 3.16."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "CO₂ today",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "adsb-co2"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "adsb-co2"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COALESCE(sum(co2_kg), 0) / 1000 AS co2_t FROM track_points WHERE ts >= date_trunc('day', now())"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "unit": "suffix: t"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {

          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT t.tier, COALESCE(100 * sum(p.co2_kg) / NULLIF(sum(sum(p.co2_kg)) OVER (), 0), 0) AS share\nFROM (VALUES (1, 'openap'), (2, 'mapped'), (3, 'category'), (4, 'unmodeled')) AS t(ord, tier)\nLEFT JOIN passes p ON p.tier = t.tier AND $__timeFilter(p.entered_at)\nGROUP BY t.ord, t.tier ORDER BY t.ord"
        }

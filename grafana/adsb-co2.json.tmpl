  "description": "Estimated in-flight CO₂ (kg) from aircraft inside the study area. Local in-area burn only; not full-flight, not CO₂e.",
  "templating": {
    "list": [
      {
        "name": "pass_id",
        "label": "Pass",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "adsb-co2"
        },
        "refresh": 2,
        "sort": 0,
        "query": "SELECT id AS __value, concat(to_char(entered_at AT TIME ZONE '${TZ}', 'MM-DD HH24:MI'), ' ', COALESCE(callsign, hex), ' ', COALESCE(type, '?')) AS __text FROM passes ORDER BY entered_at DESC LIMIT 200",
        "definition": "recent passes",
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },

            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "Central estimate, kg since local midnight (database timezone)."
    },
    {
      "id": 5,
      "type": "table",
      "title": "In area now",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "adsb-co2"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "adsb-co2"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT p.callsign, p.type, p.operator, t.alt_ft, t.gs_kt, t.vs_fpm,\n       t.co2_kg * 3600 / t.dt_s AS co2_kg_h, round((t.co2_kg * 3600 / t.dt_s / 3.16)::numeric, 0) AS fuel_kg_h, p.tier\nFROM passes p\nJOIN LATERAL (SELECT *, extract(epoch FROM ts - lag(ts) OVER (ORDER BY ts)) AS dt_s\n              FROM (SELECT * FROM track_points WHERE pass_id = p.id ORDER BY ts DESC LIMIT 2) last2\n              ORDER BY ts DESC LIMIT 1) t ON true\nWHERE p.status = 'open' ORDER BY co2_kg_h DESC NULLS LAST"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "co2_kg_h"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {}
    },

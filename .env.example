# Copy to .env and fill in. Placeholders only: never commit real values.

# Receiver location (required)
CENTER_LAT=
CENTER_LON=
RADIUS_NM=25
ALT_MIN_FT=0
ALT_MAX_FT=60000

AIRCRAFT_JSON_URL=http://ultrafeeder-collector/data/aircraft.json
GAP_TIMEOUT_S=300
STORE_INTERVAL_S=5
PUBLISH_INTERVAL_S=30
TZ=UTC

DB_HOST=adsb-co2-db
DB_PORT=5432
DB_NAME=adsb_co2
DB_USER=adsb_co2
DB_PASSWORD=changeme

# MQTT is disabled when MQTT_HOST is empty. Keep discovery off until acceptance checks pass.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=adsb_co2
MQTT_PASSWORD=changeme
HA_DISCOVERY=false

# Uptime Kuma push monitor URL, e.g. https://kuma.example/api/push/TOKEN?status=up&msg=OK
KUMA_PUSH_URL=
